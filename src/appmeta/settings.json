{
  "format_version": 1,
  "version": 1,
  "fields": {
    "tempo": {
      "type": "integer",
      "label": "Tempo (BPM)",
      "default": 80,
      "min": 40,
      "max": 200,
      "step": 5
    },
    "beats": {
      "type": "enum",
      "label": "Beats per chord",
      "default": "4",
      "options": [
        { "value": "2", "label": "2 (half bar)" },
        { "value": "4", "label": "4 (one bar)" },
        { "value": "8", "label": "8 (two bars)" }
      ]
    },
    "after_round": {
      "type": "enum",
      "label": "After each round",
      "default": "fourth",
      "options": [
        { "value": "fourth", "label": "Move up a fourth (C, F, Bb...)" },
        { "value": "semitone", "label": "Move up a semitone" },
        { "value": "stay", "label": "Stay in the same key" }
      ]
    }
  }
}
